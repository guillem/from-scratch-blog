# Public site origin used for canonical URLs, Open Graph, RSS, Atom, and the sitemap.
# This is not a secret. On Netlify, URL / DEPLOY_PRIME_URL are used as fallbacks.
SITE_URL=http://localhost:4321

# Local-only admin impersonation for development and automated tests.
# NEVER set these in the Netlify UI for production, branch deploys, or Deploy Previews.
# The application also refuses the bypass when CONTEXT is a hosted Netlify deploy.
# DEV_AUTH_BYPASS=true
# DEV_ADMIN_EMAIL=admin@localhost

# Provided automatically by Netlify Database in `netlify dev`, functions, and deploys.
# For CI/tests, the test harness sets this to an ephemeral database.
# On a legacy Netlify plan, set this yourself to a Neon (or other Postgres) URL
# in the Netlify UI with scope Builds + Functions + Runtime.
# NETLIFY_DB_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Override the hosted-deploy seed refusal. Leave unset locally.
# ALLOW_PROD_SEED=true
