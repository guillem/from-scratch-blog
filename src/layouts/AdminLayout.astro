---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const email = Astro.locals.user?.email;
---

<BaseLayout title={title} wide>
  <p class="meta">Signed in as {email}. <a href="/login">Account</a></p>
  <nav class="site-nav" aria-label="Administration">
    <a href="/admin" aria-current={Astro.url.pathname === "/admin" ? "page" : undefined}
      >Posts</a
    >
    <a href="/admin/posts/new">New post</a>
    <a
      href="/admin/tags"
      aria-current={Astro.url.pathname === "/admin/tags" ? "page" : undefined}>Tags</a
    >
  </nav>
  <slot />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      const message = form.dataset.confirm;
      if (message && !window.confirm(message)) {
        event.preventDefault();
      }
    });
  });
</script>
