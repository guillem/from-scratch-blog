---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const email = Astro.locals.user?.email;
---

<BaseLayout title={title} wide>
  <p class="meta">Signed in as {email}. <a href="/login">Account</a></p>
  <nav class="site-nav" aria-label="Administration">
    <a href="/admin" aria-current={Astro.url.pathname === "/admin" ? "page" : undefined}
      >Posts</a
    >
    <a href="/admin/posts/new">New post</a>
    <a
      href="/admin/tags"
      aria-current={Astro.url.pathname === "/admin/tags" ? "page" : undefined}>Tags</a
    >
  </nav>
  <slot />
</BaseLayout>
